import argparse, json, re, subprocess, sys, urllib.request
from collections import Counter
from html.parser import HTMLParser

PSQL = ["docker", "exec", "-i", "data_engine_postgres", "psql",
        "-U", "admin", "-d", "data_engine", "-t", "-A"]
STOP = set("the a an and or of to in for on with is are be it that this as at by from your you we our can will not have has more than then them they their what when which who how all any but if so up out about into over just also".split())


def db(query, **variables):
    cmd = PSQL[:]
    for k, v in variables.items():
        cmd += ["-v", k + "=" + str(v)]
    r = subprocess.run(cmd, input=query, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("database error: " + r.stderr.strip())
    return r.stdout.strip()


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.text, self.heads, self.skip, self.h = [], [], 0, None

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style", "noscript"):
            self.skip += 1
        if tag in ("h1", "h2", "h3"):
            self.h = []

    def handle_endtag(self, tag):
        if tag in ("script", "style", "noscript"):
            self.skip = max(0, self.skip - 1)
        if tag in ("h1", "h2", "h3") and self.h is not None:
            h = " ".join(self.h).strip()
            if h:
                self.heads.append(h)
            self.h = None

    def handle_data(self, data):
        if self.skip:
            return
        self.text.append(data)
        if self.h is not None:
            self.h.append(data.strip())


def fetch(url):
    ua = "UMET-GapCheck/1.0 (+https://ultimatemove.co.uk)"
    req = urllib.request.Request(url, headers={"User-Agent": ua})
    with urllib.request.urlopen(req, timeout=25) as r:
        html = r.read().decode("utf-8", "ignore")
    p = Page()
    p.feed(html)
    return " ".join(p.text), p.heads


def tokens(text):
    return [w for w in re.findall(r"[a-z][a-z'-]{2,}", text.lower()) if w not in STOP]


def terms(text):
    t = tokens(text)
    return Counter(t) + Counter(" ".join(p) for p in zip(t, t[1:]))


def severity(g):
    if g >= 0.75:
        return "critical"
    if g >= 0.5:
        return "high"
    if g >= 0.25:
        return "medium"
    return "low"


FIND = """SELECT d.id || ',' || d.tenant_id FROM documents d
JOIN tenants t ON t.id = d.tenant_id
WHERE t.slug = 'ultimate-move' AND d.filename = :'fn';"""

SAVE = """INSERT INTO gap_analysis_results
(tenant_id, document_id, gap_score, severity, before_coverage,
missing_topics, recommendations, metadata)
VALUES (:'t', :'d', :'g', :'s', :'c',
ARRAY(SELECT jsonb_array_elements_text(:'mt'::jsonb)),
ARRAY(SELECT jsonb_array_elements_text(:'rc'::jsonb)),
:'m'::jsonb);"""


ap = argparse.ArgumentParser()
ap.add_argument("--competitor", required=True)
ap.add_argument("--keyword", required=True)
ap.add_argument("--page", default="home.html")
ap.add_argument("--save", action="store_true")
a = ap.parse_args()

row = db(FIND, fn=a.page)
if not row:
    sys.exit("UMET page not found: " + a.page)
doc_id, tenant_id = row.split(",")
mine = db("SELECT raw_text FROM documents WHERE id = :'id';", id=doc_id)
theirs, heads = fetch(a.competitor)
if len(theirs.split()) < 60:
    print("WARNING: competitor page has very little text (it may need JavaScript).")

mine_terms = set(terms(mine))
top = [t for t, _ in terms(theirs).most_common(60)]
missing = [t for t in top if t not in mine_terms]
coverage = 1 - len(missing) / len(top) if top else 0.0
low = mine.lower()


def covered(h):
    tk = set(tokens(h))
    return not tk or sum(t in low for t in tk) / len(tk) >= 0.5


open_heads = [h for h in heads if not covered(h)]
gap = round(1 - coverage, 4)
sev = severity(gap)

print("Keyword:        ", a.keyword)
print("UMET page:      ", a.page, "(" + str(len(mine.split())) + " words)")
print("Competitor page:", a.competitor, "(" + str(len(theirs.split())) + " words)")
print("Term coverage:  ", str(round(coverage * 100)) + "%  Gap score:", gap, " Severity:", sev)
print("Competitor terms UMET lacks:", ", ".join(missing[:15]) or "none")
print("Competitor headings UMET does not cover:")
for h in open_heads[:10]:
    print("  -", h)

if a.save:
    recs = ["Cover: " + t for t in missing[:10]]
    recs += ["Add a section on: " + h for h in open_heads[:5]]
    meta = {"keyword": a.keyword, "competitor_url": a.competitor,
            "umet_words": len(mine.split()), "competitor_words": len(theirs.split()),
            "uncovered_headings": open_heads[:20], "method": "competitor_page_compare"}
    db(SAVE, t=tenant_id, d=doc_id, g=gap, s=sev, c=round(coverage, 4),
       mt=json.dumps(missing[:15]), rc=json.dumps(recs), m=json.dumps(meta))
    print("Saved to gap_analysis_results.")
