# DATA ENGINE — Celery Worker
# Inherits the heavy ML/system-dep base layer. Only adds:
#   • thin runtime packages (~30 pkgs, ~10 s)
#   • all services + worker source files
FROM data_engine-base

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY configs/ ./configs/
COPY shared/ ./shared/
COPY services/ ./services/
COPY workers/ ./workers/

RUN mkdir -p storage/uploads storage/processed storage/vectors storage/exports storage/logs

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser \
    && chown -R appuser:appgroup /app/storage
USER appuser

ENV C_FORCE_ROOT=false

CMD ["celery", "-A", "workers.celery.app", "worker", \
     "--loglevel=info", \
     "--concurrency=4", \
     "--queues=default,embeddings,ingestion,telemetry"]
