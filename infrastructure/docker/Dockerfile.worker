# DATA ENGINE — Celery Worker
# Inherits the heavy ML/system-dep base layer. Only adds:
#   • thin runtime packages (~30 pkgs, ~10 s)
#   • all services + worker source files
FROM data_engine-base

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright + Chromium for headless site crawling
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN pip install --no-cache-dir playwright &&     apt-get update -qq &&     apt-get install -y --no-install-recommends         libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0         libatk-bridge2.0-0 libcups2 libdrm2 libatspi2.0-0 libexpat1         libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3         libxrandr2 libgbm1 libxcb1 libxkbcommon0 libpango-1.0-0         libcairo2 libasound2 &&     playwright install chromium &&     rm -rf /var/lib/apt/lists/*

COPY configs/ ./configs/
COPY shared/ ./shared/
COPY services/ ./services/
COPY workers/ ./workers/

RUN mkdir -p storage/uploads storage/processed storage/vectors storage/exports storage/logs

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser \
    && chown -R appuser:appgroup /app/storage
USER appuser

ENV C_FORCE_ROOT=false

CMD ["celery", "-A", "workers.celery.app", "worker", \
     "--loglevel=info", \
     "--concurrency=4", \
     "--queues=default,embeddings,ingestion,telemetry"]
