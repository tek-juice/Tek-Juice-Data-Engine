# ── LOCAL DEV OVERRIDES ───────────────────────────────────────────────────────
# Loaded automatically when running services with python run.py (outside Docker).
# Uses 127.0.0.1 instead of localhost to bypass macOS DNS resolution entirely.

PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_ENABLED=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
