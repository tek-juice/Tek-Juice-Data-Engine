# ── LOCAL DEV OVERRIDES ───────────────────────────────────────────────────────
# Loaded automatically when running services with python run.py (outside Docker).
# Overrides .env so hostnames point at localhost instead of Docker service names.
# This file is safe to commit — it contains no secrets.

# When running locally, PgBouncer is exposed on localhost:6432
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# Postgres direct (used by Alembic migrations run locally)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis is exposed on localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery also needs localhost URLs when running outside Docker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
