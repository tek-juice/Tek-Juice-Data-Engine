# ── LOCAL DEV OVERRIDES ───────────────────────────────────────────────────────
# Loaded automatically when running services with python run.py (outside Docker).
# Uses 127.0.0.1 instead of localhost to bypass macOS DNS resolution entirely.
# Settings in this file override the main .env. Later values win.

# ── Infrastructure ────────────────────────────────────────────────────────────
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_ENABLED=false          # Must be false locally — PgBouncer is Docker-only

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ── CORS — covers Vite dev server + API gateway local ports ──────────────────
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:6145,http://localhost:6146

# ── CRITICAL FIX: Embedding model name ───────────────────────────────────────
# .env has "models/text-embedding-004" which breaks get_vector_column() in
# embedding_pipeline.py — EMBEDDING_MODELS keys are bare names without prefix.
# The Gemini provider strips "models/" internally, but the pipeline lookup runs
# BEFORE that strip and raises ValueError, killing every embedding task.
DEFAULT_EMBEDDING_MODEL=text-embedding-004
DEFAULT_EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768

# ── LLM Writing Agent ─────────────────────────────────────────────────────────
# Explicit so the writing agent never falls through to the no-key silent failure.
LLM_WRITING_PROVIDER=gemini
LLM_WRITING_MODEL=gemini-2.5-flash
LLM_WRITING_MAX_TOKENS=1200

# ── Indirect / Public Signal Channels ────────────────────────────────────────
# All default to true in settings.py, but explicit here so behaviour is
# visible and can be toggled without touching code.
INDIRECT_SIGNALS_ENABLED=true
INDIRECT_NITTER_ENABLED=true
INDIRECT_REDDIT_ENABLED=true
INDIRECT_TIKTOK_WEB_ENABLED=true
INDIRECT_YOUTUBE_RSS_ENABLED=true
INDIRECT_GITHUB_ENABLED=true
INDIRECT_WIKIPEDIA_ENABLED=true
INDIRECT_MEDIUM_ENABLED=true
INDIRECT_GOOGLE_TRENDS_ENABLED=true
INDIRECT_INSTAGRAM_PUBLIC_ENABLED=true

# ── Pipeline Intervals ────────────────────────────────────────────────────────
GAP_AUTO_CLOSE_INTERVAL_SECONDS=21600

# ── Webhook Delivery ──────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=15.0
WEBHOOK_MAX_RETRIES=3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_STANDARD=100
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_WINDOW_SECONDS=60

