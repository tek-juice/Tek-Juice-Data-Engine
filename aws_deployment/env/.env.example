# ============================================================
# Tek Juice Data Engine — Environment Variables
# Copy this to .env and fill in your real values:
#   cp aws_deployment/env/.env.example .env
# NEVER commit your real .env to git.
# ============================================================

# ── App ───────────────────────────────────────────────────────
ENV=production
PORT=9600
SECRET_KEY=your-very-long-random-secret-key-here-min-32-chars
DEBUG=false
ALLOWED_HOSTS=*

# ── Database (PostgreSQL + pgvector) ─────────────────────────
DATABASE_URL=postgresql://tek_juice_user:your_db_password@postgres:5432/tek_juice_db
POSTGRES_DB=tek_juice_db
POSTGRES_USER=tek_juice_user
POSTGRES_PASSWORD=your_strong_database_password_here

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:your_redis_password@redis:6379/0
REDIS_PASSWORD=your_strong_redis_password_here

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=tek-juice-data-engine-storage

# ── AI / Embeddings ───────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Ingestion Service ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
SUPPORTED_FILE_TYPES=pdf,csv,json,txt,docx,xlsx

# ── Telemetry ─────────────────────────────────────────────────
TELEMETRY_ENABLED=true
TELEMETRY_INTERVAL_SECONDS=60

# ── Trend Scraper ─────────────────────────────────────────────
GOOGLE_TRENDS_REGION=US
BING_API_KEY=your-bing-api-key-here

# ── SEO Engine ────────────────────────────────────────────────
SEO_ANALYSIS_ENABLED=true

# ── Monitoring ────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
