# ============================================================
# Tek Juice Data Engine — Complete Environment Variables
# Copy to project root: cp aws_deployment/env/.env.example .env
# Fill in all YOUR_ values before deploying.
# NEVER commit your real .env to git.
# ============================================================


# ── APPLICATION CORE ──────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=YOUR_SECRET_KEY_MIN_32_CHARS_HERE_CHANGE_THIS
APP_LOG_LEVEL=INFO
APP_VERSION=1.0.0
APP_NAME=Tek Juice Data Engine


# ── API GATEWAY ───────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9600
GATEWAY_ALLOWED_ORIGINS=http://54.86.109.228:9600,http://localhost:9600


# ── SECURITY / AUTH ───────────────────────────────────────────
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_MIN_32_CHARS_HERE_CHANGE_THIS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_HEADER=X-API-Key
BCRYPT_ROUNDS=12


# ── GOOGLE OAUTH 2.0 ──────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET


# ── POSTGRESQL (AWS RDS) ──────────────────────────────────────
POSTGRES_HOST=tekjuice-stage.crs2y40iif4i.us-east-1.rds.amazonaws.com
POSTGRES_PORT=3306
POSTGRES_DB=tek_juice_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=YOUR_RDS_PASSWORD
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_ECHO=false
# Full connection URL (used by some services directly)
DATABASE_URL=postgresql+asyncpg://admin:TekJuice@2026!@postgres:5432/data_engine


# ── PGBOUNCER (Connection Pooler) ─────────────────────────────
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_ENABLED=false


# ── REDIS ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0


# ── CELERY (Task Queue) ───────────────────────────────────────
CELERY_BROKER_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:YOUR_REDIS_PASSWORD@redis:6379/1


# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=tek-juice-data-engine-storage


# ── AI / EMBEDDING PROVIDERS ──────────────────────────────────
DEFAULT_EMBEDDING_PROVIDER=gemini
# NOTE: Do NOT prefix model name with "models/" here
DEFAULT_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=5

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Voyage AI
VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY

# Jina AI
JINA_API_KEY=YOUR_JINA_API_KEY


# ── LLM WRITING AGENT (Gap Detection) ────────────────────────
LLM_WRITING_PROVIDER=gemini
LLM_WRITING_MODEL=gemini-2.5-flash
LLM_WRITING_MAX_TOKENS=1200


# ── CHUNKING SERVICE ──────────────────────────────────────────
CHUNK_MIN_TOKENS=256
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
SEMANTIC_CHUNK_SIMILARITY_THRESHOLD=0.85


# ── VECTOR SEARCH ─────────────────────────────────────────────
VECTOR_SIMILARITY_THRESHOLD=0.75
VECTOR_TOP_K=10
HNSW_M=16
HNSW_EF_CONSTRUCTION=64


# ── TREND SCRAPER ─────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY
GOOGLE_SEARCH_CX=YOUR_GOOGLE_CUSTOM_SEARCH_ENGINE_ID
BING_SEARCH_API_KEY=YOUR_BING_SEARCH_API_KEY
SCRAPER_API_KEY=YOUR_SCRAPER_API_KEY
SCRAPER_INTERVAL_SECONDS=3600
SCRAPER_RATE_LIMIT_RPM=30
SCRAPER_REQUEST_DELAY=2.0


# ── SOCIAL MEDIA APIs ─────────────────────────────────────────
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET
REDDIT_USER_AGENT=TekJuiceDataEngine/1.0

TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN

FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN

TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET

SNAPCHAT_ACCESS_TOKEN=YOUR_SNAPCHAT_ACCESS_TOKEN

YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY


# ── INDIRECT / PUBLIC SIGNAL CHANNELS (no API keys needed) ───
INDIRECT_SIGNALS_ENABLED=true
INDIRECT_NITTER_ENABLED=true
INDIRECT_REDDIT_ENABLED=true
INDIRECT_TIKTOK_WEB_ENABLED=true
INDIRECT_YOUTUBE_RSS_ENABLED=true
INDIRECT_GITHUB_ENABLED=true
INDIRECT_WIKIPEDIA_ENABLED=true
INDIRECT_MEDIUM_ENABLED=true
INDIRECT_GOOGLE_TRENDS_ENABLED=true
INDIRECT_INSTAGRAM_PUBLIC_ENABLED=true
NITTER_INSTANCES=


# ── DATAFORSEO (SEO + Rank Tracking) ─────────────────────────
DATAFORSEO_LOGIN=YOUR_DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD=YOUR_DATAFORSEO_PASSWORD
RANK_TRACKING_INTERVAL_SECONDS=86400
AUTHORITY_TRACKING_INTERVAL_SECONDS=86400


# ── PROXY / ANTI-BLOCKING ─────────────────────────────────────
PROXY_URL=
PROXY_POOL=


# ── BROWSER / PLAYWRIGHT ──────────────────────────────────────
HEADLESS_BROWSER_ENABLED=true
PLAYWRIGHT_BROWSER=chromium
HEADLESS_MAX_CONCURRENT=3
SESSION_POOL_SIZE=3
SESSION_TTL_SECONDS=1800


# ── NER / spaCy ───────────────────────────────────────────────
SPACY_NER_ENABLED=true
WIKIDATA_LINKING_ENABLED=true


# ── GAP DETECTION ─────────────────────────────────────────────
GAP_AUTO_CLOSE_INTERVAL_SECONDS=21600


# ── WEBHOOKS ──────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=15.0
WEBHOOK_MAX_RETRIES=3


# ── TELEMETRY SERVICE ─────────────────────────────────────────
TELEMETRY_WORKER_COUNT=4
TELEMETRY_QUEUE_MAX_SIZE=10000
TELEMETRY_FLUSH_INTERVAL_SECONDS=30


# ── STORAGE ───────────────────────────────────────────────────
STORAGE_BASE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100
SUPPORTED_FILE_TYPES=pdf,csv,json,txt,docx,xlsx


# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_STANDARD=100
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_WINDOW_SECONDS=60


# ── MONITORING ────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_ADMIN_PASSWORD


# ── SERVICE PORTS (internal microservice ports) ───────────────
INGESTION_SERVICE_PORT=8001
CHUNKING_SERVICE_PORT=8002
EMBEDDING_SERVICE_PORT=8003
VECTOR_VAULT_PORT=8004
TELEMETRY_SERVICE_PORT=8005
TREND_SCRAPER_PORT=8006
SEMANTIC_ENGINE_PORT=8007
GAP_DETECTION_PORT=8008
SCHEMA_FACTORY_PORT=8009
SYNC_SERVICE_PORT=8010
DASHBOARD_BACKEND_PORT=8011
SEO_ENGINE_PORT=8012
GEO_ENGINE_PORT=8013
AEO_ENGINE_PORT=8014


# ── DOCKER SERVICE HOST ROUTING (set automatically by docker-compose) ──
# These tell the API Gateway how to reach each microservice inside Docker.
# You do NOT need to change these — docker-compose sets them automatically.
SERVICE_HOST_INGESTION_SERVICE=ingestion_service
SERVICE_HOST_EMBEDDING_SERVICE=embedding_service
SERVICE_HOST_VECTOR_VAULT=vector_vault
SERVICE_HOST_TELEMETRY_SERVICE=telemetry_service
SERVICE_HOST_TREND_SCRAPER=trend_scraper
SERVICE_HOST_SEMANTIC_ENGINE=semantic_engine
SERVICE_HOST_GAP_DETECTION=gap_detection
SERVICE_HOST_SCHEMA_FACTORY=schema_factory
SERVICE_HOST_DASHBOARD_BACKEND=dashboard_backend
SERVICE_HOST_SEO_ENGINE=seo_engine
SERVICE_HOST_GEO_ENGINE=geo_engine
SERVICE_HOST_AEO_ENGINE=aeo_engine
